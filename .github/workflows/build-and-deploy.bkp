name: Build and Push to ACR

on:
  push:
    branches:
      - main

env:
  REGISTRY: ${{ secrets.ACR_LOGIN_SERVER }}
  ACR_NAME: roboshoprc

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        service:
          - frontend
          - cart
          - payment
          - user
          - catalogue
          - shipping
          - debug
          - mongodb
          - mysql
          - redis
          - rabbitmq

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Login to ACR
        uses: azure/docker-login@v1
        with:
          login-server: ${{ secrets.ACR_LOGIN_SERVER }}
          username: ${{ secrets.AZURE_CLIENT_ID }}
          password: ${{ secrets.AZURE_CLIENT_SECRET }}

      - name: Build Docker image
        run: |
          docker build \
            -t ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:${{ github.sha }} \
            -t ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:latest \
            ./${{ matrix.service }}/

          echo "✅ Image built: ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:${{ github.sha }}"

      - name: Trivy Scan
        continue-on-error: true
        run: |
          echo "🔍 Scanning for CRITICAL vulnerabilities..."
          trivy image \
            --severity CRITICAL \
            --exit-code 0 \
            ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:latest || true

      - name: Push to ACR
        run: |
          docker push ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:${{ github.sha }}
          docker push ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:latest
          echo "✅ Pushed: ${{ env.REGISTRY }}/${{ env.ACR_NAME }}-${{ matrix.service }}:latest"

      - name: Cleanup
        if: always()
        run: docker logout ${{ env.REGISTRY }} || true
